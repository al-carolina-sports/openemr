<!DOCTYPE html>
<html>
<head>
    <title>{{ 'AI Assistant Settings'|xlt }}</title>
    {{ setupHeader(['common']) }}
</head>
<body class="body_top">
<div class="container-fluid mt-3 mb-5" style="max-width: 960px;">
    <h3>{{ 'AI Assistant'|xlt }}</h3>
    <p class="text-muted small">{{ 'A chat panel for staff that answers scheduling questions through an AI model on Amazon Bedrock (covered by the practice\'s AWS BAA). Phase 1 is read only: it looks things up and never changes the calendar.'|xlt }}</p>

    {% if notice %}<div class="alert alert-success py-2" role="status">{{ notice|xlt }}</div>{% endif %}
    {% if test %}
        <div class="alert {{ test.ok ? 'alert-success' : 'alert-danger' }} py-2" role="status">
            <strong>{{ (test.ok ? 'Connection works.' : 'Connection failed.')|xlt }}</strong> {{ test.message|text }}
        </div>
    {% endif %}

    <form method="post" novalidate>
        <input type="hidden" name="{{ csrfField|attr }}" value="{{ csrfToken|attr }}">

        <section class="card mb-4"><div class="card-header"><strong>{{ 'Status'|xlt }}</strong></div><div class="card-body">
            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" id="enabled" name="enabled" value="1"{% if settings.enabled %} checked{% endif %}>
                <label class="form-check-label" for="enabled">{{ 'Assistant enabled (shows the chat button in the top bar for users with the AI Assistant "use" right)'|xlt }}</label>
            </div>
            <div class="form-group mb-0">
                <label for="practice_name">{{ 'Practice name used in the assistant\'s instructions'|xlt }}</label>
                <input class="form-control" id="practice_name" name="practice_name" maxlength="100" value="{{ settings.practiceName|attr }}">
            </div>
        </div></section>

        <section class="card mb-4"><div class="card-header"><strong>{{ 'AI model (Amazon Bedrock)'|xlt }}</strong></div><div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-8">
                    <label for="model_id">{{ 'Model or inference profile id'|xlt }}</label>
                    <input class="form-control text-monospace" id="model_id" name="model_id" value="{{ settings.modelId|attr }}">
                    <small class="form-text text-muted">{{ 'Default: us.meta.llama4-maverick-17b-instruct-v1:0. Use only models on the standard Bedrock runtime that the BAA covers.'|xlt }}</small>
                </div>
                <div class="form-group col-md-4">
                    <label for="region">{{ 'AWS region'|xlt }}</label>
                    <input class="form-control text-monospace" id="region" name="region" value="{{ settings.region|attr }}">
                </div>
            </div>
            <div class="form-group">
                <label for="credentials_file">{{ 'Credentials file (used when the web server environment has no AWS_ACCESS_KEY_ID)'|xlt }}</label>
                <input class="form-control text-monospace" id="credentials_file" name="credentials_file" value="{{ settings.credentialsFile|attr }}">
                <small class="form-text text-muted">{{ 'Credentials found in:'|xlt }} <strong>{{ credentialsSource|text }}</strong>. {{ 'Keys are never stored in the database.'|xlt }}</small>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm" name="action" value="test">{{ 'Test connection (sends "Reply with the word OK.", no patient data)'|xlt }}</button>
            <small class="text-muted ml-2">{{ 'Tests the saved settings; save changes first.'|xlt }}</small>
        </div></section>

        <section class="card mb-4"><div class="card-header"><strong>{{ 'Limits and retention'|xlt }}</strong></div><div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-3">
                    <label for="max_tool_calls">{{ 'Tool calls per message'|xlt }}</label>
                    <input class="form-control text-right" id="max_tool_calls" name="max_tool_calls" inputmode="numeric" value="{{ settings.maxToolCalls|attr }}">
                </div>
                <div class="form-group col-md-3">
                    <label for="messages_per_hour">{{ 'Messages per user per hour'|xlt }}</label>
                    <input class="form-control text-right" id="messages_per_hour" name="messages_per_hour" inputmode="numeric" value="{{ settings.messagesPerHour|attr }}">
                </div>
                <div class="form-group col-md-3">
                    <label for="max_output_tokens">{{ 'Max reply tokens'|xlt }}</label>
                    <input class="form-control text-right" id="max_output_tokens" name="max_output_tokens" inputmode="numeric" value="{{ settings.maxOutputTokens|attr }}">
                </div>
                <div class="form-group col-md-3">
                    <label for="log_retention_days">{{ 'Keep chat log (days)'|xlt }}</label>
                    <input class="form-control text-right" id="log_retention_days" name="log_retention_days" inputmode="numeric" value="{{ settings.logRetentionDays|attr }}">
                </div>
            </div>
            <small class="text-muted">{{ 'The chat log holds patient information. A daily background job deletes rows older than this.'|xlt }}</small>
        </div></section>

        <section class="card mb-4"><div class="card-header"><strong>{{ 'Open times'|xlt }}</strong></div><div class="card-body">
            <p class="small text-muted">{{ 'On days with "In Office" / "Out Of Office" events, open times are only offered between them. On days with neither:'|xlt }}</p>
            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" id="use_default_hours" name="use_default_hours" value="1"{% if settings.useDefaultHours %} checked{% endif %}>
                <label class="form-check-label" for="use_default_hours">
                    {{ 'Assume the calendar hours on working days'|xlt }}
                    ({{ (officeHours.startMinute // 60)|text }}:00 – {{ (officeHours.endMinute // 60)|text }}:00, {{ 'every'|xlt }} {{ officeHours.stepMinutes|text }} {{ 'min'|xlt }}, {{ timezone|text }})
                </label>
            </div>
            <div class="mb-1">{{ 'Working days'|xlt }}:</div>
            {% for num, label in weekdays %}
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="wd{{ num|attr }}" name="working_days[]" value="{{ num|attr }}"{% if num in settings.workingDays %} checked{% endif %}>
                    <label class="form-check-label" for="wd{{ num|attr }}">{{ label|xlt }}</label>
                </div>
            {% endfor %}
            <small class="form-text text-muted">{{ 'Calendar hours and interval come from Admin > Config > Calendar.'|xlt }}</small>
        </div></section>

        <button type="submit" class="btn btn-primary" name="action" value="save">{{ 'Save'|xlt }}</button>
    </form>
</div>
</body>
</html>
