{% import 'admin/macros.html.twig' as m %}
<p class="small text-muted">{{ 'Use only when an office sells this product at a different price.'|xlt }}</p>
<table class="table table-sm">
    <thead><tr><th>{{ 'Office'|xlt }}</th><th class="text-right">{{ 'Price to patient'|xlt }}</th><th></th></tr></thead>
    <tbody>
    {% for row in p.rows %}
        <tr>
            <td>{{ p.facilityNames[row.facility_id]|default('#' ~ row.facility_id)|text }}</td>
            <td class="text-right">{{ row.price_to_patient|money|text }}</td>
            <td class="text-right">
                <form method="post" class="d-inline" data-confirm="{{ 'Remove this row?'|xla }}">
                    {{ m.panelForm(key, 'delete', csrfField, csrfToken) }}
                    <input type="hidden" name="facility_id" value="{{ row.facility_id|attr }}">
                    <button class="btn btn-link btn-sm p-0 text-danger">{{ 'Remove'|xlt }}</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="3" class="text-muted">{{ 'Same price in every office.'|xlt }}</td></tr>
    {% endfor %}
    </tbody>
</table>
<form method="post" class="form-row align-items-end">
    {{ m.panelForm(key, 'save', csrfField, csrfToken) }}
    <div class="col-md-5 mb-2"><label class="small">{{ 'Office'|xlt }}</label>
        <select class="form-control form-control-sm" name="facility_id" required><option value="">{{ '-- choose --'|xlt }}</option>
            {% for fid, name in p.facilities %}<option value="{{ fid|attr }}">{{ name|text }}</option>{% endfor %}</select></div>
    <div class="col-md-3 mb-2"><label class="small">{{ 'Price'|xlt }}</label><input class="form-control form-control-sm text-right" name="price_to_patient" inputmode="decimal" required></div>
    <div class="col-md-2 mb-2"><button class="btn btn-secondary btn-sm">{{ 'Save'|xlt }}</button></div>
</form>
