{% import '@cashpay/admin/macros.html.twig' as m %}
<p class="small text-muted">{{ 'These products come out of stock at the office where the procedure is delivered.'|xlt }}</p>
<table class="table table-sm">
    <thead><tr><th>{{ 'Product'|xlt }}</th><th class="text-right">{{ 'Quantity used'|xlt }}</th><th></th></tr></thead>
    <tbody>
    {% for row in p.rows %}
        <tr>
            <td>{{ row.name|text }}</td>
            <td class="text-right">{{ row.qty|text }}</td>
            <td class="text-right">
                <form method="post" class="d-inline" data-confirm="{{ 'Remove this row?'|xla }}">
                    {{ m.panelForm(key, 'delete', csrfField, csrfToken) }}
                    <input type="hidden" name="product_id" value="{{ row.product_id|attr }}">
                    <button class="btn btn-link btn-sm p-0 text-danger">{{ 'Remove'|xlt }}</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="3" class="text-muted">{{ 'No products linked.'|xlt }}</td></tr>
    {% endfor %}
    </tbody>
</table>
<form method="post" class="form-row align-items-end">
    {{ m.panelForm(key, 'save', csrfField, csrfToken) }}
    <div class="col-md-6 mb-2"><label class="small">{{ 'Product'|xlt }}</label>
        <select class="form-control form-control-sm" name="product_id" required><option value="">{{ '-- choose --'|xlt }}</option>
            {% for pid, name in p.products %}<option value="{{ pid|attr }}">{{ name|text }}</option>{% endfor %}</select></div>
    <div class="col-md-2 mb-2"><label class="small">{{ 'Quantity'|xlt }}</label><input class="form-control form-control-sm text-right" name="qty" value="1" inputmode="decimal" required></div>
    <div class="col-md-2 mb-2"><button class="btn btn-secondary btn-sm">{{ 'Save'|xlt }}</button></div>
</form>
