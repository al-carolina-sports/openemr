<!DOCTYPE html>
<html>
<head>
    <title>{{ block('title')|text }}</title>
    {{ setupHeader(headerAssets|default(['common'])) }}
    <link rel="stylesheet" href="{{ patientUrl|attr }}../assets/cashpay.css">
</head>
<body class="body_top cpi">
<div class="container-fluid mt-2 mb-5">
    <div class="d-flex flex-wrap align-items-baseline justify-content-between mb-2">
        <h4 class="mb-1">{{ patient.name|text }} <small class="text-muted">#{{ patient.pubpid|text }}</small></h4>
        <ul class="nav nav-pills cpi-patient-nav">
            <li class="nav-item"><a class="nav-link{{ navTab|default('') == 'invoices' ? ' active' : '' }}" href="{{ patientUrl|attr }}account.php?tab=invoices">{{ 'Invoices'|xlt }}</a></li>
            <li class="nav-item"><a class="nav-link{{ navTab|default('') == 'quotes' ? ' active' : '' }}" href="{{ patientUrl|attr }}account.php?tab=quotes">{{ 'Quotes'|xlt }}</a></li>
            <li class="nav-item"><a class="nav-link{{ navTab|default('') == 'payments' ? ' active' : '' }}" href="{{ patientUrl|attr }}payments.php">{{ 'Payments'|xlt }}</a></li>
            <li class="nav-item"><a class="nav-link{{ navTab|default('') == 'rewards' ? ' active' : '' }}" href="{{ patientUrl|attr }}rewards.php">{{ 'Rewards'|xlt }}</a></li>
            <li class="nav-item"><a class="nav-link{{ navTab|default('') == 'notes' ? ' active' : '' }}" href="{{ patientUrl|attr }}notes.php">{{ 'Financial Notes'|xlt }}</a></li>
        </ul>
    </div>
    {% if notice %}
        <div class="alert alert-success py-2" role="status">{{ notice|xlt }}</div>
    {% endif %}
    {% block content %}{% endblock %}
</div>
{% block scripts %}{% endblock %}
</body>
</html>
