{% extends '@cashpay/admin/base.html.twig' %}
{% block title %}{{ 'Memberships and Cards'|xlt }}{% endblock %}
{% block crumbs %}<li class="breadcrumb-item active">{{ 'Memberships and Cards'|xlt }}</li>{% endblock %}
{% block content %}
    <h3>{{ 'Memberships and Cards'|xlt }}</h3>
    <h5 class="mt-3">{{ 'Autopay failures'|xlt }}</h5>
    <table class="table table-sm small cpi-table">
        <thead class="thead-light"><tr><th>{{ 'Patient'|xlt }}</th><th>{{ 'Plan'|xlt }}</th><th>{{ 'Last error'|xlt }}</th></tr></thead>
        <tbody>
        {% for f in failures %}<tr><td>{{ f.patient|text }}</td><td>{{ f.plan_name|text }}</td><td>{{ f.last_autopay_error|text }}</td></tr>
        {% else %}<tr><td colspan="3" class="text-muted">{{ 'None.'|xlt }}</td></tr>{% endfor %}
        </tbody>
    </table>
    <h5 class="mt-3">{{ 'Memberships due'|xlt }}</h5>
    <p class="small text-muted">{{ 'Plans set to create the monthly invoice automatically are billed by the background job every hour. The others are billed from the patient Membership page with "Bill next period".'|xlt }}</p>
    <table class="table table-sm small cpi-table">
        <thead class="thead-light"><tr><th>{{ 'Patient'|xlt }}</th><th>{{ 'Plan'|xlt }}</th><th>{{ 'Due'|xlt }}</th><th>{{ 'Billing'|xlt }}</th><th>{{ 'Autopay'|xlt }}</th></tr></thead>
        <tbody>
        {% for d in due %}
            <tr><td>{{ d.patient|text }} <span class="text-muted">#{{ d.pid|text }}</span></td><td>{{ d.plan|text }}</td><td>{{ d.next|text }}</td>
                <td>{{ d.auto ? 'Automatic'|xlt : 'Bill by hand'|xlt }}</td><td>{{ d.autopay ? 'On'|xlt : 'Off'|xlt }}{% if d.error %} <span class="text-danger">{{ d.error|text }}</span>{% endif %}</td></tr>
        {% else %}<tr><td colspan="5" class="text-muted">{{ 'Nothing due.'|xlt }}</td></tr>{% endfor %}
        </tbody>
    </table>
    <h5 class="mt-3">{{ 'Patients who need a card on file'|xlt }}</h5>
    {% if not stripeOn %}<p class="small text-warning">{{ 'Stripe is not set up yet, so card links cannot be sent.'|xlt }}</p>{% endif %}
    <p class="small text-muted">{{ 'Patients flagged during the move from PatientNow, and patients on autopay with no saved card. Open the patient, go to Cash-Pay > Payments, and use "Send card-on-file link", or collect the card on a reader at check-in.'|xlt }}</p>
    <table class="table table-sm small cpi-table">
        <thead class="thead-light"><tr><th>{{ 'Patient'|xlt }}</th><th>{{ 'Email'|xlt }}</th><th>{{ 'Cell'|xlt }}</th><th>{{ 'Why'|xlt }}</th><th>{{ 'Last link sent'|xlt }}</th></tr></thead>
        <tbody>
        {% for c in cards %}
            <tr><td>{{ c.patient|text }} <span class="text-muted">#{{ c.pid|text }}</span></td><td>{{ c.email|text }}</td><td>{{ c.phone|text }}</td>
                <td>{% if c.flagged %}{{ 'Flagged'|xlt }}{% endif %}{% if c.plans %} {{ 'Autopay'|xlt }}: {{ c.plans|text }}{% endif %}</td><td>{{ c.lastLink|text }}</td></tr>
        {% else %}<tr><td colspan="5" class="text-muted">{{ 'Nobody.'|xlt }}</td></tr>{% endfor %}
        </tbody>
    </table>
{% endblock %}
